<Window x:Class="CoffeeMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeMachine"
        mc:Ignorable="d"
        Title="Кофейный автомат" Height="500" Width="700"  Background="White">
    <Border Background="White" Margin="5" CornerRadius="3">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBox Name="TbMoneyInput" Height="25" Margin="0,0,50,10" 
                         Text="0" FontSize="14" Padding="2"/>
                <Button Name="BtnEnterMoney" Content="Внести деньги" Height="30" Margin="0,0,50,0" Click="BtnEnterMoney_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="20,0,0,0">
                <TextBlock Name="TxtBalance" Text="Внесенная сумма: 0" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock Name="TxtChange" Text="Сдача:" FontSize="16" Margin="0,0,0,20"/>
                <TextBlock Name="TxtPrice" Text="Цена напитка: 0" FontSize="18" FontWeight="Regular" HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <RadioButton Name="RbAmericano" Content="Американо" GroupName="Coffee" Margin="0,10" Checked="Drink_Checked"/>
                    <RadioButton Name="RbCappuccino" Content="Капучино" GroupName="Coffee" Margin="0,10" Checked="Drink_Checked"/>
                    <RadioButton Name="RbEspresso" Content="Эспрессо" GroupName="Coffee" Margin="0,10" Checked="Drink_Checked"/>
                    <RadioButton Name="RbCocoa" Content="Какао" GroupName="Coffee" Margin="0,10" Checked="Drink_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <CheckBox Name="CbSugar" Content="Сахар" Margin="0,10" Checked="Addon_Checked" Unchecked="Addon_Unchecked"/>
                    <CheckBox Name="CbMilk" Content="Молоко" Margin="0,10" Checked="Addon_Checked" Unchecked="Addon_Unchecked"/>
                </StackPanel>
            </Grid>

            <Button Name="BtnOk" Grid.Row="3" Grid.Column="0" Content="ОК" Height="30" VerticalAlignment="Center" Click="BtnOk_Click" Margin="0,0,50,0"/>

            <Image Name="ImgMain" Grid.Row="2" Grid.Column="1" 
                   Stretch="Uniform" VerticalAlignment="Bottom" Margin="10"/>

            <Image Name="ImgMilk" Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" 
                   Source="/Images/milk.jpg" Visibility="Hidden"
                   Stretch="Uniform" VerticalAlignment="Bottom"/>

            <Image Name="ImgSugar" Grid.Row="3" Grid.Column="1" 
                   Source="/Images/sugar.jpg" Visibility="Hidden"
                   Stretch="UniformToFill" VerticalAlignment="Bottom" Height="70"/>
        </Grid>
    </Border>
</Window>
